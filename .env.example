# --- api ---
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview?schema=public
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
CANDIDATE_JWT_EXPIRES_IN=12h
WEB_ORIGIN=http://localhost:5173
# Public URL used in invite links when sharing over a tunnel, e.g. https://<name>.ngrok-free.app
# PUBLIC_WEB_URL=
RETENTION_DAYS=90
LOCK_GRACE_SECONDS=30
RETURN_LINK_TTL_MINUTES=15
# --- production / self-hosting (see docs/self-hosting.md); leave unset in development ---
# WEB_DIST_DIR=        # serve the built web app from the API (single origin)
# TRUST_PROXY=false    # Express `trust proxy`; enable only behind a proxy you control
# CLIENT_IP_HEADER=    # real client IP header for rate limiting, e.g. cf-connecting-ip
