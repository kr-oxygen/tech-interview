# Production settings for docker-compose.prod.yml. Copy to .env.prod next to the compose file,
# fill in the placeholders and keep it private (chmod 600). Never commit .env.prod.

# --- database (read by the db service and used in DATABASE_URL) ---
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me            # openssl rand -base64 24 (avoid / + @ or URL-encode them)
POSTGRES_DB=interview
DATABASE_URL=postgresql://interview:change-me@db:5432/interview?schema=public

# --- app ---
NODE_ENV=production
JWT_SECRET=change-me-at-least-32-characters   # openssl rand -base64 48
JWT_EXPIRES_IN=12h
CANDIDATE_JWT_EXPIRES_IN=12h
# Public URL of the app (CORS origin and invite links).
WEB_ORIGIN=https://interview.example.com
PUBLIC_WEB_URL=https://interview.example.com

# Behind a reverse proxy or tunnel. Only enable when the app port is reachable solely through it.
TRUST_PROXY=true
# Header with the real client IP set by your edge proxy, used for rate limiting
# (cf-connecting-ip for Cloudflare, x-real-ip for a typical nginx setup). Leave empty otherwise.
CLIENT_IP_HEADER=

RETENTION_DAYS=90
LOCK_GRACE_SECONDS=30
RETURN_LINK_TTL_MINUTES=15
